# SmartTask Backend — Pemboleh Ubah Persekitaran
# Salin fail ini sebagai .env satu folder di atas Backend/:
#   cp Backend/.env.example .env
# JANGAN commit fail .env ke Git.

# ─── Pangkalan Data (XAMPP MySQL) ───────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smarttask_db

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Dapatkan kunci API di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── JWT (JSON Web Token) ───────────────────────────────────────────────────
# Tukar kepada rentetan rawak yang panjang dan rahsia dalam persekitaran produksi.
# Contoh jana: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_string_rawak_panjang_dan_rahsia

# ─── Pelayan ─────────────────────────────────────────────────────────────────
PORT=5000
